@{
    ViewData["Title"] = "AnaSayfa";
}



<!-- END nav -->
<div class="hero-wrap js-fullheight" id="anasayfa" style="background-image: url('/VeterinerTemplate/images/bg_1.jpg');" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text js-fullheight align-items-center justify-content-center" data-scrollax-parent="true">
            <div class="col-md-11 ftco-animate text-center">
                <h1 class="mb-4">"Sevginizle büyüyen dostlarınız, bizimle sağlıklı kalır!" </h1>
                <p><a href="tel:+90 538 484 65 11" class="btn btn-primary mr-md-4 py-3 px-4">İletişime Geçin<span class="ion-ios-arrow-forward"></span></a></p>
            </div>
        </div>
    </div>
</div>
 

<section class="ftco-section ftco-no-pt ftco-no-pb" id="hakkimizda">
    <div class="container">
        <div class="row d-flex no-gutters">
            <div class="col-md-5 d-flex">
                <div class="img img-video d-flex align-self-stretch align-items-center justify-content-center justify-content-md-center mb-4 mb-sm-0" style="background-image:url(/VeterinerTemplate/images/about-1.png);background-size: contain;">
                </div>
            </div>
            <div class="col-md-7 pl-md-5 py-md-5">
                <div class="heading-section pt-md-5">
                    <h2 class="mb-4">Hakkımızda</h2>
                    <p>Dargeçit Cevheroğlu Veteriner Kliniği, 2025 yılında Levent Vural tarafından Mardin’in Dargeçit ilçesinde kurulmuştur. Bölgedeki evcil hayvan sahiplerine ve çiftçilere yüksek kaliteli veteriner sağlık hizmetleri sunmak amacıyla kurulan klinik, modern tıbbi ekipmanları ve uzman kadrosuyla hayvan sağlığı alanında güvenilir bir merkez olmayı hedeflemektedir.</p>
                </div>
                <div class="row">
                    <div class="col-md-6 services-2 w-100 d-flex">
                        <div class="icon d-flex align-items-center justify-content-center"><span class="flaticon-stethoscope"></span></div>
                        <div class="text pl-3">
                            <h4>Bakım Önerileri</h4>
                            <p>Evcil hayvanlarınızın sağlığını korumak  için uzman profesyonel bakım tavsiyeleri.</p>
                        </div>
                    </div>
                    <div class="col-md-6 services-2 w-100 d-flex">
                        <div class="icon d-flex align-items-center justify-content-center"><span class="flaticon-customer-service"></span></div>
                        <div class="text pl-3">
                            <h4>Müşteri Destek Hizmetleri</h4>
                            <p>Her türlü sorunuz ve ihtiyacınız için 7/24 destek.</p>
                        </div>
                    </div>
                    <div class="col-md-6 services-2 w-100 d-flex">
                        <div class="icon d-flex align-items-center justify-content-center"><span class="flaticon-emergency-call"></span></div>
                        <div class="text pl-3">
                            <h4>Acil Veteriner Hizmetleri</h4>
                            <p>Acil durumlarda hızlı ve etkili müdahale ile hayvanlarınızın sağlığını korumak için  hizmetinizdeyiz.</p>
                        </div>
                    </div>
                    <div class="col-md-6 services-2 w-100 d-flex">
                        <div class="icon d-flex align-items-center justify-content-center"><span class="flaticon-veterinarian"></span></div>
                        <div class="text pl-3">
                            <h4>Veteriner Uzman Desteği</h4>
                            <p>Hayvanlarınızın ve çiftlik hayvanlarınızın her türlü sağlık ihtiyacına profesyonel çözümler sunuyoruz.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section bg-light" id="hizmetlerimiz">
    <div class="container">
        <div class="row justify-content-center pb-5 mb-3">
            <div class="col-md-7 heading-section text-center ftco-animate fadeInUp ftco-animated">
                <h2>Hizmetlerimiz</h2>
            </div>
        </div>
        <div class="row mb-5 pb-5"> 
            <div class="col-md-4 d-flex align-self-stretch px-4 ftco-animate fadeInUp ftco-animated">
                <div class="d-block services text-center">
                    <div class="icon d-flex align-items-center justify-content-center">
                        <span class="flaticon-dog-eating"></span>
                    </div>
                    <div class="media-body p-4">
                        <h3 class="heading">Vitamin ve Beslenme</h3>
                        <p>Hayvanlarınızın sağlıklı gelişimi için özel vitamin takviyeleri ve beslenme danışmanlığı.</p>
                        <a   class="btn-custom d-flex align-items-center justify-content-center"><span class="fa fa-chevron-right"></span><i class="sr-only">Read more</i></a>
                    </div>
                </div>
            </div>
            <div class="col-md-4 d-flex align-self-stretch px-4 ftco-animate fadeInUp ftco-animated">
                <div class="d-block services text-center">
                    <div class="icon d-flex align-items-center justify-content-center">
                        <span class="flaticon-blind"></span>
                    </div>
                    <div class="media-body p-4">
                        <h3 class="heading">Sağlık Kontrolleri</h3>
                        <p>Periyodik sağlık kontrolleri ile evcil hayvanlarınızın sağlığını sürekli takip ediyoruz.</p>
                        <a  class="btn-custom d-flex align-items-center justify-content-center"><span class="fa fa-chevron-right"></span><i class="sr-only">Read more</i></a>
                    </div>
                </div>
            </div>
            <div class="col-md-4 d-flex align-self-stretch px-4 ftco-animate fadeInUp ftco-animated"> 
                <div class="d-block services text-center">
                    <div class="icon d-flex align-items-center justify-content-center">
                        <span class="flaticon-veterinarian"></span>
                    </div>
                    <div class="media-body p-4">
                        <h3 class="heading">Acil Müdahale</h3>
                        <p>7/24 acil veteriner hizmetleriyle her an yanınızdayız.</p>
                        <a  class="btn-custom d-flex align-items-center justify-content-center"><span class="fa fa-chevron-right"></span><i class="sr-only">Read more</i></a>
                    </div>
                </div>
            </div>
            </div>
        </div> 
    </div>
</section>

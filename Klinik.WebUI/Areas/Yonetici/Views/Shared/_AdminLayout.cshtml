<!DOCTYPE html>
<html lang="en">


<!-- Mirrored from themewagon.github.io/product-admin/ by HTTrack Website Copier/3.x [XR&CO'2014], Tue, 30 Sep 2025 07:34:08 GMT -->
<!-- Added by HTTrack -->
<meta http-equiv="content-type" content="text/html;charset=utf-8" /><!-- /Added by HTTrack -->
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Veteriner Klinik Admin Sayfası</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:400,700">
    <!-- https://fonts.google.com/specimen/Roboto -->
    <link rel="stylesheet" href="~/ProductAdmin/css/fontawesome.min.css">
    <!-- https://fontawesome.com/ -->
    <link rel="stylesheet" href="~/ProductAdmin/css/bootstrap.min.css">
    <!-- https://getbootstrap.com/ -->
    <link rel="stylesheet" href="~/ProductAdmin/css/templatemo-style.css">
    <!--
    Product Admin CSS Template
    https://templatemo.com/tm-524-product-admin
    --> 
    <style>
        .table {
            width: 100%;
            table-layout: inherit;
            border-collapse: unset;
        }

            .table th, .table td {
                text-align: left;
                padding: 8px;
                overflow: hidden;
                white-space: nowrap;
            }
    </style>
</head>

<body id="reportsPage">
    <div class="" id="home">
        <nav class="navbar navbar-expand-xl">
            <div class="container h-100">
                <a class="navbar-brand" href="/Yonetici/Anasayfa/Index">
                    <h1 class="tm-site-title mb-0">Cevheroğlu Klinik</h1>
                </a>
                <button class="navbar-toggler ml-auto mr-0" type="button" data-toggle="collapse" data-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="fas fa-bars tm-nav-icon"></i>
                </button>

                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav mx-auto h-100">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"].ToString() == "Index" ? "active" : "")" href="/Yonetici/Anasayfa/Index">
                                <i class="fas fa-tachometer-alt"></i>
                                Admin Sayfası
                                <span class="sr-only">(current)</span>
                            </a>
                        </li>
                        <li class="nav-item dropdown">  
                                <a class="nav-link @(ViewContext.RouteData.Values["action"].ToString() == "AylikRapor" ? "active" : "")" href="/Yonetici/AnaSayfa/AylikRapor">
                                <i class="far fa-file-alt"></i> <span>   Aylık Rapor  </span>
                            </a> 
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"].ToString() == "HaftalikRapor" ? "active" : "")" href="/Yonetici/AnaSayfa/HaftalikRapor">
                                <i class="far fa-file-alt"></i>
                                Haftalık Rapor
                            </a>
                        </li> 
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"].ToString() == "IlacEkle" ? "active" : "")" href="/Yonetici/AnaSayfa/IlacEkle">
                                <i class="fas fa-shopping-cart"></i>
                                İlaç Ekle
                            </a>
                        </li> 
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link d-block" href="/Anasayfa/Cikis">
                                Cevheroğlu Klinik, <b>Çıkış</b>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

        </nav>
        <div class="container">
            @RenderBody()
        </div> 
    </div>

    <script src="~/ProductAdmin/js/jquery-3.3.1.min.js"></script>
    <!-- https://jquery.com/download/ -->
    <script src="~/ProductAdmin/js/moment.min.js"></script>
    <!-- https://momentjs.com/ -->
    <script src="~/ProductAdmin/js/Chart.min.js"></script>
    <!-- http://www.chartjs.org/docs/latest/ -->
    <script src="~/ProductAdmin/js/bootstrap.min.js"></script>
    <!-- https://getbootstrap.com/ -->
    <script src="~/ProductAdmin/js/tooplate-scripts.js"></script> 
    <!-- Flatpickr CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <!-- Flatpickr JS -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <!-- Flatpickr Türkçe Dil Desteği -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/tr.js"></script>
    <script>
        // Flatpickr'ı Türkçe olarak başlat
        flatpickr("#expire_date", {
            dateFormat: "d.m.Y", // Türkçeye uygun format (örn: 25.10.2025)
            locale: "tr", // Türkçe dil desteği
            allowInput: true, // Kullanıcı elle tarih girebilsin
            clickOpens: true, // Input'a tıklayınca takvim açılsın
            onReady: function() {
                console.log("Takvim başlatıldı!");
            },
            onOpen: function() {
                console.log("Input'a tıklandı, takvim açıldı!");
            }
        });
    </script>
</body>



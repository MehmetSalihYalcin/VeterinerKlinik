@using Klinik.DTO.MedicineDTOS
@using PagedList
@model PagedList<ResultMedicineDTO>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Yonetici/Views/Shared/_AdminLayout.cshtml"; 
}
<!-- row -->
<div class="row">
    <div class="col">
        <p class="text-white mt-5 mb-5">Hoşgeldin, <b>Levent</b></p>
    </div>
</div>
<div class="row tm-content-row">
    <div class="col-sm-12 col-md-12 col-lg-6 col-xl-6 tm-block-col">
    </div>
    <div class="col-12 tm-block-col">
        <div class="tm-bg-primary-dark tm-block tm-block-taller tm-block-scroll" style="max-height:100%">
           <div>
               <div class="row">
                   <div class="col-lg-6">
                        <h2 class="tm-block-title">İlaçl istesi</h2>
                   </div>
                    <div class="col-lg-6">
                        <div class="search-container">
                            <form method="get" class="d-flex" role="search">
                                <div class="form-group w-100 me-2">
                                    <input id="name" name="searchTerm" type="text" class="form-control" placeholder="Seri Numarası Ara...">
                                </div>
                                <button type="submit" class="btn btn-primary" style="max-height: 50px;">
                                    <i class="fas fa-search"></i>
                                </button>
                            </form>
                        </div>
                    </div>
               </div>
           </div>
            <table class="table">
                <thead>
                    <tr> 
                        <th scope="col" style="width:15%">Seri Numarası</th>
                        <th scope="col" style="width:10%">İlaç Adı</th>
                        <th scope="col" style="width:45%">İlaç Açıklaması</th>
                        <th scope="col" style="width:5%">Fiyat(TL)</th>
                        <th scope="col" style="width:5%">Adet</th>
                        <th scope="col" style="width:10%">Tarih</th>
                        <th scope="col" style="width:5%">Düzenle</th>
                        <th scope="col" style="width:5%">sil</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    { 
                        <tr> 
                            <td>
                                @item.SerialNumber
                            </td>
                            <td><b>@item.MedicineName</b></td>
                            <td><b>@(item.MedicineDescription.Length <= 80 ? item.MedicineDescription : item.MedicineDescription.Substring(0, 80)+"...")</b></td>
                            <td><b>@item.MedicinePrice ₺</b></td>
                            <td>@item.MedicinePiece</td>
                            <td>@item.CreateDate.ToShortDateString()</td>
                            <td>
                                <a href="/Yonetici/AnaSayfa/IlacGuncelle/@item.Id" class="tm-product-delete-link">
                                    <i class="fas fa-pen tm-product-delete-icon"></i>
                                </a>
                            </td>
                            <td>
                                <a href="/Yonetici/AnaSayfa/IlacSil/@item.Id" class="tm-product-delete-link">
                                    <i class="far fa-trash-alt tm-product-delete-icon"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <nav aria-label="Page navigation">
                <ul class="pagination mt-4" style="overflow: overlay;">
                    @if (Model.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="/Yonetici/AnaSayfa/Index?page=@(Model.PageNumber - 1)">Geri</a>
                        </li>
                    }

                    @for (int i = 1; i <= Model.PageCount; i++)
                    {
                        <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                            <a class="page-link" href="/Yonetici/AnaSayfa/Index?page=@i">@i</a>
                        </li>
                    }

                    @if (Model.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="/Yonetici/AnaSayfa/Index?page=@(Model.PageNumber + 1)">İleri</a>
                        </li>
                    }

                </ul>
            </nav>
        </div>
    </div>
</div>

